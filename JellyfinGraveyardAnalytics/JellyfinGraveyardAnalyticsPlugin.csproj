<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JellyfinGraveyardAnalytics</RootNamespace>
    <Nullable>enable</Nullable>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      One place the version lives. build.yaml and manifest.json carry the same
      four-part number, and release.sh checks that all three agree before it ships.
      Jellyfin reads the assembly version when it lists an installed plugin, so a
      missing one showed as 1.0.0.0 whatever the release was called.
    -->
    <Version>1.2.0.5</Version>
    <AssemblyVersion>1.2.0.5</AssemblyVersion>
    <FileVersion>1.2.0.5</FileVersion>
    <Authors>jackwander</Authors>
    <Product>Graveyard Analytics</Product>
    <Company>jackwander</Company>
  </PropertyGroup>

  <!--
    Reproducibility. release.yml commits manifest.json with an MD5 of the zip and then
    rebuilds that zip in CI, refusing to publish if the two disagree — so the build has to
    be a function of the source and nothing else. Three inputs broke that, none of them
    visible without comparing bytes:

    - The SDK appends the git commit to AssemblyInformationalVersion, and SourceLink (on by
      default since .NET 8) writes the same commit into the PDB. That made the design
      *circular*: the checksum goes into a commit, the commit changes the SHA, the SHA
      changes the DLL, the DLL changes the checksum. EnableSourceControlManagerQueries
      stops the SDK consulting git at all, which is what closes it.
    - The debug directory records the absolute path of the PDB —
      /private/var/www/... on the maintainer's machine, /home/runner/... on CI. PathMap
      rewrites it to a fixed stand-in.
    - Zip entry mtimes, handled in release.sh.

    DebugType is `embedded` rather than `none` so the PDB travels inside the DLL and a
    stack trace in a user's Jellyfin log still carries line numbers; only the two
    assemblies ship either way.

    Verified: the same source builds byte-identical from two different directories, with
    and without a .git present, and across an intervening commit. Remove any of these and
    the release workflow starts failing its own checksum gate.
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
  </PropertyGroup>

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned, not floating, and deliberately pinned to the *oldest* server this plugin
      supports. Compiling against the oldest ABI is what keeps one artifact loadable across
      the whole 10.11.x line; compiling against the newest would silently raise the floor.

      "10.11.*-*" resolved to 10.11.11, which removed IUserManager.Users and broke the build
      from a clean checkout. That break was the visible half of a worse one: the *shipped*
      plugin called the removed member, so it loaded on a 10.11.9+ server (targetAbi is a
      minimum) and then failed when the Guestbook was opened. Services/UserManagerCompat.cs
      resolves that accessor by name instead, so the pin no longer decides which servers work
      — tests/harness/dotnet/abi checks the built assembly against several 10.11.x releases.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.6" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.6" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <!--
      Compile against it, never ship it. Jellyfin already loads Microsoft.Data.Sqlite
      and SQLitePCLRaw into the same context, and a second copy in the plugin directory
      is how you get a native-provider clash. release.sh has only ever shipped Dapper.dll
      and the plugin, so this makes the publish directory say what the release always did.

      Both asset classes, not just "runtime": that one drops the managed assemblies but
      leaves the `native` RID assets, so publish still emitted a runtimes/ tree carrying
      e_sqlite3 for twenty platforms. The CI shipped-set check is what caught it.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebUI\dashboard.html" />
    <!--
      The home screen row's client half, served by GraveyardAnalyticsController.GetHomeScript
      and injected into index.html only when EnableHomeSection is on.
    -->
    <EmbeddedResource Include="WebUI\home.js" />
    <!--
      Chapel collection artwork. Embedded because the controller used to fetch these
      from raw.githubusercontent.com at condemn time: a plugin that only brands the
      collection correctly when the server has outbound internet and the repo is
      still at that path.
    -->
    <EmbeddedResource Include="Resources\thechapelcollectionthumbnail.jpg" />
    <EmbeddedResource Include="Resources\thechapelcollectionbackdrop.jpg" />
  </ItemGroup>
</Project>
